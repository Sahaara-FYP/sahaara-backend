generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  fullName            String             @map("full_name") @db.VarChar(150)
  username            String?            @unique @db.VarChar(50)
  email               String             @unique @db.VarChar(100)
  phoneNumber         String?            @unique @map("phone_number") @db.VarChar(20)
  address String? 
  passwordHash        String             @map("password_hash")
  gender              Gender?            @default(male)
  dateOfBirth         DateTime?          @map("date_of_birth")
  profilePictureUrl   String?            @map("profile_picture_url")
  bio                 String?
  cnicNumber          String?            @map("cnic_number") @db.VarChar(20)
  skills              Json?
  role                UserRole           @default(user)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  completedOnboarding Boolean            @default(false) @map("completed_onboarding")

  // Relations (arrays for convenience)
  requests              Request[]
  requestParticipations RequestParticipator[]
  // offers               Offer[]
  alerts                Alert[]
  alertAcknowledgements AlertAcknowledgement[]
  passwordResetTokens PasswordResetToken[]

  verifications Verification[]
}

model Verification {
  id             String   @id @default(uuid())
  userId         String @map("user_id")
  user           User     @relation(fields: [userId], references: [id])

  cnicFrontUrl    String @map("cnic_front_url")
  cnicBackUrl     String  @map("cnic_back_url")
  selfieWithCnicUrl String       @map("selfie_with_cnic_url")

  status         VerificationStatus @default(pending)
  adminNotes     String? @map("admin_notes")

  createdAt      DateTime @default(now()) @map("created_at")
  verifiedAt     DateTime? @map("verified_at")
}

model Request {
  id                     String           @id @default(uuid())
  userId                 String           @map("user_id")
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  category               RequestCategory  @default(general)
  urgencyLevel           UrgencyLevel     @default(normal) @map("urgency_level")
  status                 RequestStatus    @default(pending)
  locationLat            Float            @map("location_lat")
  locationLng            Float            @map("location_lng")
  postAnonymously        Boolean          @default(false) @map("post_anonymously")
  visibilityVerifiedOnly Boolean          @default(false) @map("visibility_verified_only")
  priorityScore          Float?           @default(0) @map("priority_score")
  visibilityWomenOnly    Boolean          @default(false) @map("visibility_women_only")
  moderationStatus       ModerationStatus @default(clean) @map("moderation_status")
  maxHelpers             Int?             @default(1) @map("max_helpers")
  completedAt            DateTime?        @map("completed_at")
  expiresAt              DateTime?        @map("expires_at")
  attachments            Json?
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relations
  participators RequestParticipator[]
  // ratings              Rating[]

  @@unique([createdAt, id])
}

model RequestParticipator {
  id        String @id @default(uuid())
  requestId String @map("request_id")
  userId    String @map("user_id")

  status    ParticipationStatus @default(pending)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  // Relations
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId], name: "unique_request_user")
  @@unique([createdAt, id], name: "createdAt_id")
}

model Alert {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String           @db.VarChar(255)
  description      String?          @db.Text
  category         AlertCategory    @default(general)
  urgencyLevel     UrgencyLevel     @default(normal) @map("urgency_level")
  locationLat      Decimal          @map("location_lat") @db.Decimal(10, 7)
  locationLng      Decimal          @map("location_lng") @db.Decimal(10, 7)
  attachments      Json?
  status           AlertStatus      @default(active)
  moderationStatus ModerationStatus @default(clean) @map("moderation_status")
  expiryTime       DateTime?        @map("expiry_time")

  acknowledgements AlertAcknowledgement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([createdAt, id])
}

model AlertAcknowledgement {
  id       String  @id @default(uuid())
  alertId  String  @map("alert_id")
  userId   String  @map("user_id")
  comments String?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([alertId, userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String 
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AlertStatus {
  active
  resolved
  expired
  cancelled
}

enum ParticipationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum UrgencyLevel {
  normal
  high
  low
}

enum RequestStatus {
  pending
  partially_accepted
  accepted
  completed
  cancelled
  expired
}

enum ModerationStatus {
  clean
  flagged
  reviewed
  blocked
}

enum RequestCategory {
  general
  shelter
  food
  medical
  transportation
  financial
  education
  employment
  legal
  counseling
  safety
  other
}

enum Gender {
  male
  female
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum UserRole {
  user
  admin
  moderator
}

enum AlertCategory {
  general
  emergency
  health
  security
  weather
  traffic
  missing_person
  lost_and_found
  natural_disaster
  community_notice
  event
  other
}
