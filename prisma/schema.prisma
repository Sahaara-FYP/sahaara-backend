generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String             @id @default(uuid())
  fullName            String             @map("full_name") @db.VarChar(150)
  username            String?            @unique @db.VarChar(50)
  email               String             @unique @db.VarChar(100)
  phoneNumber         String?            @unique @map("phone_number") @db.VarChar(20)
  address String? 
  passwordHash        String             @map("password_hash")
  gender              Gender?            @default(male)
  dateOfBirth         DateTime?          @map("date_of_birth")
  profilePictureUrl   String?            @map("profile_picture_url")
  bio                 String?
  cnicNumber          String?            @unique @map("cnic_number") @db.VarChar(20)
  skills              Json?
  role                UserRole           @default(user)
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")
  completedOnboarding Boolean            @default(false) @map("completed_onboarding")
  isVerified Boolean @default(false) @map("is_verified")
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  // Location (synced from mobile app)
  lastLocationLat       Float?             @map("last_location_lat")
  lastLocationLng       Float?             @map("last_location_lng")
  locationUpdatedAt     DateTime?          @map("location_updated_at")

  // Trust / Rating
  averageRating         Float?             @default(0) @map("average_rating")
  totalRatings          Int                @default(0) @map("total_ratings")

  // Push Notifications
  pushToken             String?            @map("push_token")

  // Relations (arrays for convenience)
  requests              Request[]
  requestParticipations RequestParticipator[]
  offers                Offer[]
  offerInteractions     OfferInteraction[]
  alerts                Alert[]
  alertAcknowledgements AlertAcknowledgement[]
  passwordResetTokens PasswordResetToken[]

  verifications Verification[]

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  ratingsGiven    Rating[] @relation("RatingFrom")
  ratingsReceived Rating[] @relation("RatingTo")
  notifications   Notification[]

  chatParticipations ChatParticipant[]
  messagesSent       Message[]
}

model Verification {
  id             String   @id @default(uuid())
  userId         String @map("user_id")
  user           User     @relation(fields: [userId], references: [id])

  cnicFrontUrl    String @map("cnic_front_url")
  cnicBackUrl     String  @map("cnic_back_url")
  selfieWithCnicUrl String       @map("selfie_with_cnic_url")

  status         VerificationStatus @default(pending)
  adminNotes     String? @map("admin_notes")

  createdAt      DateTime @default(now()) @map("created_at")
  verifiedAt     DateTime? @map("verified_at")
}

model Request {
  id                     String           @id @default(uuid())
  userId                 String           @map("user_id")
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                  String
  description            String?
  category               RequestCategory  @default(general)
  urgencyLevel           UrgencyLevel     @default(normal) @map("urgency_level")
  status                 RequestStatus    @default(pending)
  locationLat            Float            @map("location_lat")
  locationLng            Float            @map("location_lng")
  postAnonymously        Boolean          @default(false) @map("post_anonymously")
  visibilityVerifiedOnly Boolean          @default(false) @map("visibility_verified_only")
  priorityScore          Float?           @default(0) @map("priority_score")
  visibilityWomenOnly    Boolean          @default(false) @map("visibility_women_only")
  moderationStatus       ModerationStatus @default(clean) @map("moderation_status")
  maxHelpers             Int?             @default(1) @map("max_helpers")
  completedAt            DateTime?        @map("completed_at")
  expiresAt              DateTime?        @map("expires_at")
  attachments            Json?
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @default(now()) @updatedAt @map("updated_at")

  // Relations
  participators RequestParticipator[]
  // ratings              Rating[]
  chatRooms     ChatRoom[]

  @@unique([createdAt, id])
}

model Rating {
  id        String   @id @default(uuid())
  fromId    String   @map("from_id")
  toId      String   @map("to_id")

  score     Int      // 1–5
  comment   String?  @db.Text

  // Context (at least one should be set)
  requestId String?  @map("request_id")
  offerId   String?  @map("offer_id")

  createdAt DateTime @default(now()) @map("created_at")

  from User @relation("RatingFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("RatingTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@unique([fromId, toId, requestId], name: "one_rating_per_request")
  @@unique([fromId, toId, offerId],   name: "one_rating_per_offer")
}

model RequestParticipator {
  id        String @id @default(uuid())
  requestId String @map("request_id")
  userId    String @map("user_id")

  status    ParticipationStatus @default(pending)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")

  // Relations
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([requestId, userId], name: "unique_request_user")
  @@unique([createdAt, id], name: "createdAt_id")
}

model Alert {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String           @db.VarChar(255)
  description      String?          @db.Text
  category         AlertCategory    @default(general)
  urgencyLevel     UrgencyLevel     @default(normal) @map("urgency_level")
  locationLat      Decimal          @map("location_lat") @db.Decimal(10, 7)
  locationLng      Decimal          @map("location_lng") @db.Decimal(10, 7)
  attachments      Json?
  status           AlertStatus      @default(active)
  moderationStatus ModerationStatus @default(clean) @map("moderation_status")
  expiryTime       DateTime?        @map("expiry_time")

  acknowledgements AlertAcknowledgement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([createdAt, id])
}

model AlertAcknowledgement {
  id       String  @id @default(uuid())
  alertId  String  @map("alert_id")
  userId   String  @map("user_id")
  comments String?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([alertId, userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String @map("user_id")
  tokenHash String @map("token_hash")
  expiresAt DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Offer {
  id                String           @id @default(uuid())
  userId            String           @map("user_id")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title             String           @db.VarChar(255)
  description       String?          @db.Text
  category          RequestCategory  @default(general)
  type              OfferType        @default(service)
  status            OfferStatus      @default(active)
  moderationStatus  ModerationStatus @default(clean) @map("moderation_status")

  // Spatial (Decimal matching Alerts schema for precision)
  locationLat       Decimal          @map("location_lat") @db.Decimal(10, 7)
  locationLng       Decimal          @map("location_lng") @db.Decimal(10, 7)

  // --- RESOURCE (Physical Goods) ---
  totalQuantity     Int?             @map("total_quantity")
  remainingQuantity Int?             @map("remaining_quantity")
  unit              String?          @db.VarChar(50)

  // --- SERVICE (Skills/Time) ---
  availability      String?          @db.VarChar(255)
  experienceDesc    String?          @db.Text @map("experience_desc")

  attachments       Json?
  expiresAt         DateTime?        @map("expires_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at")

  interactions      OfferInteraction[]
  chatRooms         ChatRoom[]

  @@unique([createdAt, id])
}

model OfferInteraction {
  id        String            @id @default(uuid())
  offerId   String            @map("offer_id")
  userId    String            @map("user_id")
  
  status    InteractionStatus @default(pending)
  
  // --- RESOURCE Data ---
  requestedQuantity Int?             @map("requested_quantity")

  // --- SERVICE Data ---
  message           String?          @db.Text

  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at")

  offer     Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum AlertStatus {
  active
  resolved
  expired
  cancelled
}

enum ParticipationStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum UrgencyLevel {
  normal
  high
  low
}

enum RequestStatus {
  pending
  partially_accepted
  accepted
  completed
  cancelled
  expired
}

enum ModerationStatus {
  clean
  flagged
  reviewed
  blocked
}

enum RequestCategory {
  general
  shelter
  food
  medical
  transportation
  financial
  education
  employment
  legal
  counseling
  safety
  other
}

enum Gender {
  male
  female
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum UserRole {
  user
  admin
  moderator
}

enum AlertCategory {
  general
  emergency
  health
  security
  weather
  traffic
  missing_person
  lost_and_found
  natural_disaster
  community_notice
  event
  other
}

enum OfferType {
  resource
  service
}

enum OfferStatus {
  active
  paused
  depleted // All resources claimed
  completed // Offer finished/closed
  cancelled
}

enum InteractionStatus {
  pending
  accepted
  rejected
  fulfilled
  cancelled
}

model Report {
  id           String           @id @default(uuid())
  
  // Who is reporting?
  reporterId   String           @map("reporter_id")
  reporter     User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  // What is being reported? (Polymorphic Link)
  entityType   ReportEntityType @map("entity_type")
  entityId     String           @map("entity_id")
  
  // Target User (denormalized for quick user-banning context)
  reportedUserId String?        @map("reported_user_id")
  reportedUser   User?          @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)

  reason       ReportReason
  details      String?          @db.Text
  status       ReportStatus     @default(pending)

  // Admin actions
  adminNotes   String?          @map("admin_notes") @db.Text
  resolvedAt   DateTime?        @map("resolved_at")
  
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at")
}

enum ReportEntityType {
  request
  offer
  alert
  user
  message // Future proofing
}

enum ReportReason {
  spam
  harassment
  inappropriate_content
  fraud
  hate_speech
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String
  body      String           @db.Text
  type      NotificationType
  metadata  Json?            // e.g. { requestId, offerId, alertId }
  read      Boolean          @default(false)

  createdAt DateTime         @default(now()) @map("created_at")
}

enum NotificationType {
  request_accepted
  request_completed
  offer_accepted
  offer_rejected
  offer_fulfilled
  alert_nearby
  help_request_nearby
  rating_received
  general
  new_message
}

model ChatRoom {
  id          String         @id @default(uuid())
  type        ChatRoomType
  status      ChatRoomStatus @default(active)

  // Links to either an Offer or a Request (optional polymorphic FKs)
  offerId     String?        @map("offer_id")
  requestId   String?        @map("request_id")

  offer       Offer?         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  request     Request?       @relation(fields: [requestId], references: [id], onDelete: Cascade)

  participants ChatParticipant[]
  messages     Message[]

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @default(now()) @updatedAt @map("updated_at")
}

model ChatParticipant {
  id       String   @id @default(uuid())
  roomId   String   @map("room_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String   @map("room_id")
  senderId  String   @map("sender_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

enum ChatRoomType {
  group
  direct
}

enum ChatRoomStatus {
  active
  closed
}
