generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  fullName             String    @map("full_name") @db.VarChar(150)
  username             String?    @unique @db.VarChar(50)
  email                String   @unique @db.VarChar(100)
  phoneNumber          String?    @unique @map("phone_number") @db.VarChar(20)
  passwordHash         String    @map("password_hash")
  gender               Gender? 
  dateOfBirth          DateTime? @map("date_of_birth")
  profilePictureUrl    String?   @map("profile_picture_url")
  bio                  String?
  verificationStatus   VerificationStatus @default(unverified) @map("verification_status")
  cnicNumber           String?   @map("cnic_number") @db.VarChar(20)
  cnicImageUrl         String?   @map("cnic_image_url")
  selfieUrl            String?   @map("selfie_url")
  skills               Json?
  role                 UserRole  @default(user)
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  completedOnboarding Boolean @default(false) @map("completed_onboarding")

  // Relations (arrays for convenience)
  // requests             Request[]
  // offers               Offer[]
  // alerts               Alert[]
}

enum Gender {
  male
  female
}

enum VerificationStatus {
  unverified
  pending
  verified
  rejected
}

enum UserRole {
  user
  admin
  moderator
}

